# Demo mode works with zero setup: no wallet, no funds, no database.
# Set to "false" to use the live NEAR Intents 1Click API (real money, mainnet).
DEMO_MODE=true

# Optional: 1Click JWT from https://partners.near-intents.org (removes the unauthenticated fee)
ONE_CLICK_JWT=

# Optional: Supabase persistence. Without these, invoices are kept in a local JSON file (.data/).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
